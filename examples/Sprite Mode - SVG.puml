'SPDX-License-Identifier: MIT (For details, see https://github.com/npiper/gcp-icons-for-plantuml/blob/master/LICENSE-CODE)

' SVG sprite mode - requires PlantUML >= 1.2026.x and local file includes.
' !pragma svgparser sax enables the SAX-based SVG sprite renderer.
' !define GCP_USE_SVG switches macros from the default PNG sprite to the SVG sprite.
' Remote !includeurl is NOT supported for SVG mode.

!pragma svgparser sax
!define GCPPuml ../dist

!define GCP_USE_SVG
!include GCPPuml/GCPCommon.puml
!include GCPPuml/cloud_run.puml
!include GCPPuml/cloud_build.puml
!include GCPPuml/artifact_registry.puml
!include GCPPuml/cloud_deploy.puml

left to right direction

actor "Developer" as dev

cloud_build(build, "Cloud Build", "CI Pipeline", "Builds container image on commit")
artifact_registry(registry, "Artifact Registry", "Container Registry", "Stores versioned images")
cloud_deploy(deploy, "Cloud Deploy", "CD Pipeline", "Manages rollout to environments")
cloud_run(service, "Cloud Run", "Serverless", "Runs container workload")

dev --> build : git push
build --> registry : push image
registry --> deploy : trigger release
deploy --> service : deploy revision

@enduml
