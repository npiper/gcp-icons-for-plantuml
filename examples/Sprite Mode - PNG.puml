' PNG sprite mode - default, no !define required.
' Works with any PlantUML version and remote !includeurl.
' No !pragma svgparser sax needed.

!define GCPPuml https://raw.githubusercontent.com/npiper/gcp-icons-for-plantuml/refs/heads/feature/2026-update/dist

!includeurl GCPPuml/GCPCommon.puml
!includeurl GCPPuml/cloud_run.puml
!includeurl GCPPuml/cloud_build.puml
!includeurl GCPPuml/artifact_registry.puml
!includeurl GCPPuml/cloud_deploy.puml

left to right direction

actor "Developer" as dev

cloud_build(build, "Cloud Build", "CI Pipeline", "Builds container image on commit")
artifact_registry(registry, "Artifact Registry", "Container Registry", "Stores versioned images")
cloud_deploy(deploy, "Cloud Deploy", "CD Pipeline", "Manages rollout to environments")
cloud_run(service, "Cloud Run", "Serverless", "Runs container workload")

dev --> build : git push
build --> registry : push image
registry --> deploy : trigger release
deploy --> service : deploy revision

@enduml
